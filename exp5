from collections import defaultdict
class Factor:
    def __init__(self, variables, cardinalities, values):
        """
        Represents a factor in a Bayesian Network.

        Args:
            variables: List of variable names (e.g., ['A', 'B'])
            cardinalities: List of integers specifying number of states for each variable
            values: numpy array with probability values
        """
        self.variables = variables
        self.cardinalities = cardinalities
        self.values = values
        self._validate_inputs()

    def _validate_inputs(self):
        """Validate that inputs are consistent"""
        assert len(self.variables) == len(self.cardinalities)
        assert self.values.shape == tuple(self.cardinalities)

    def factor_product(self, other):
        """
        Multiply two factors together.

        Returns:
            New Factor representing the product
        """
        # TODO: Implement factor product
        # Steps:
        # 1. Find union of variables from both factors
        # 2. Determine new cardinalities
        # 3. Align both factors to the new variable order
        # 4. Multiply the values using broadcasting

        # Example structure:
        all_vars = list(set(self.variables) | set(other.variables))
        all_vars.sort()  # For consistent ordering

        # Get cardinalities for all variables
        card_dict = {}
        for var, card in zip(self.variables, self.cardinalities):
            card_dict[var] = card
        for var, card in zip(other.variables, other.cardinalities):
            card_dict[var] = card

        new_cardinalities = [card_dict[var] for var in all_vars]

        # Align self to new variable order
        self_reordered = self._reorder_variables(all_vars)

        # Align other to new variable order
        other_reordered = other._reorder_variables(all_vars)

        # Multiply values
        # changes made here *******************************************************************************************
        new_values = self_reordered * other_reordered

        return Factor(all_vars, new_cardinalities, new_values)




    # new code added here *******************************************************************************************
    def _reorder_variables(self, new_order):
        """Reorder the factor's variables to match new_order"""
        # TODO: Implement variable reordering
        # Hint: Use np.transpose with the appropriate axis mapping
        present = [v for v in new_order if v in self.variables]
        perm = [self.variables.index(v) for v in present]
        vals = np.transpose(self.values, perm)
        shape = [self.cardinalities[self.variables.index(v)] if v in self.variables else 1 for v in new_order]
        return vals.reshape(shape)

    def sum_out(self, variable):
        """
        Sum out a variable from this factor.

        Args:
            variable: Variable name to sum out

        Returns:
            New Factor with variable eliminated
        """
        # TODO: Implement summing out a variable
        # Steps:
        # 1. Find index of variable to eliminate
        # 2. Sum along that axis
        # 3. Create new factor with remaining variables

        if variable not in self.variables:
            return self

        var_index = self.variables.index(variable)
        new_vars = [v for v in self.variables if v != variable]
        new_cardinalities = [c for i, c in enumerate(self.cardinalities) if i != var_index]

        # Sum along the specified axis
        new_values = np.sum(self.values, axis=var_index)

        return Factor(new_vars, new_cardinalities, new_values)

    def normalize(self):
        """Normalize the factor to sum to 1"""
        self.values = self.values / np.sum(self.values)
        return self

    def __str__(self):
        """String representation of the factor"""
        return f"Factor(vars={self.variables}, cards={self.cardinalities}, shape={self.values.shape})"

    def __repr__(self):
        return self.__str__()

        
def variable_elimination(factors, elimination_order, query_variables=None):
    """
    Perform variable elimination for inference.

    Args:
        factors: List of Factor objects
        elimination_order: List of variable names to eliminate
        query_variables: List of variable names to keep (if None, keep all non-eliminated)

    Returns:
        Factor representing the marginal distribution
    """
    # TODO: Implement the Variable Elimination algorithm
    # Steps:
    # 1. Make a copy of the factor list
    # 2. For each variable in elimination_order:
    #    a. Find all factors containing that variable
    #    b. Multiply them together
    #    c. Sum out the variable
    #    d. Add resulting factor back to the list
    # 3. Multiply all remaining factors
    # 4. Normalize if needed

    working_factors = factors.copy()
    max_factor_size = 0  # For Question 3 analysis

    print("Starting Variable Elimination...")

    for i, elim_var in enumerate(elimination_order):
        print(f"Step {i+1}: Eliminating {elim_var}")

        # Find factors containing the variable to eliminate
        relevant_factors = [f for f in working_factors if elim_var in f.variables]

        if not relevant_factors:
            print(f"  No factors contain {elim_var}, skipping...")
            continue

        # Remove these factors from working set
        for f in relevant_factors:
            working_factors.remove(f)

        print(f"  Multiplying {len(relevant_factors)} factors...")

        # Multiply all relevant factors
        if len(relevant_factors) == 1:
            product_factor = relevant_factors[0]
        else:
            product_factor = relevant_factors[0]
            for f in relevant_factors[1:]:
                product_factor = product_factor.factor_product(f)

        # Track maximum factor size for Question 3
        current_size = np.prod(product_factor.values.shape)
        max_factor_size = max(max_factor_size, current_size)
        print(f"  Product factor size: {current_size}")

        # Sum out the variable
        print(f"  Summing out {elim_var}...")
        new_factor = product_factor.sum_out(elim_var)
        working_factors.append(new_factor)

        print(f"  Remaining factors: {len(working_factors)}")

    # Multiply all remaining factors
    print("Multiplying remaining factors...")
    if len(working_factors) == 0:
        raise ValueError("No factors remaining after elimination")

    result = working_factors[0]
    for f in working_factors[1:]:
        result = result.factor_product(f)

    # If query_variables specified, ensure we have exactly those variables
    if query_variables is not None:
        # Sum out any extra variables not in query
        extra_vars = [v for v in result.variables if v not in query_variables]
        for var in extra_vars:
            result = result.sum_out(var)

    # Normalize the final result
    result.normalize()

    print(f"Maximum factor size during elimination: {max_factor_size}")
    return result, max_factor_size

def create_student_network():
    """
    Create the Student Bayesian Network from Koller's book
    Returns a list of factors
    """
    # Difficulty: binary [0=Easy, 1=Hard]
    factor_D = Factor(['D'], [2], np.array([0.6, 0.4]))

    # Intelligence: binary [0=Low, 1=High]
    factor_I = Factor(['I'], [2], np.array([0.7, 0.3]))

    # Grade: ternary [0=A, 1=B, 2=C]
    # P(G | I, D)
    values_G = np.zeros((2, 2, 3))  # I, D, G
    # I=Low, D=Easy
    values_G[0, 0, :] = [0.3, 0.4, 0.3]   # P(G | I=Low, D=Easy)
    # I=Low, D=Hard
    values_G[0, 1, :] = [0.05, 0.25, 0.7] # P(G | I=Low, D=Hard)
    # I=High, D=Easy
    values_G[1, 0, :] = [0.9, 0.08, 0.02] # P(G | I=High, D=Easy)
    # I=High, D=Hard
    values_G[1, 1, :] = [0.5, 0.3, 0.2]   # P(G | I=High, D=Hard)

    factor_G = Factor(['I', 'D', 'G'], [2, 2, 3], values_G)

    # SAT: binary [0=Low, 1=High]
    # P(S | I)
    values_S = np.zeros((2, 2))  # I, S
    values_S[0, :] = [0.95, 0.05]  # P(S | I=Low)
    values_S[1, :] = [0.2, 0.8]    # P(S | I=High)
    factor_S = Factor(['I', 'S'], [2, 2], values_S)

    # Letter: binary [0=Bad, 1=Good]
    # P(L | G)
    values_L = np.zeros((3, 2))  # G, L
    values_L[0, :] = [0.1, 0.9]   # P(L | G=A)
    values_L[1, :] = [0.4, 0.6]   # P(L | G=B)
    values_L[2, :] = [0.99, 0.01] # P(L | G=C)
    factor_L = Factor(['G', 'L'], [3, 2], values_L)

    return [factor_D, factor_I, factor_G, factor_S, factor_L]


def create_loan_network():
    """
    Create the Loan Approval network for Question 4
    """
    # Age: binary [0=Young, 1=Old] - Protected attribute
    factor_A = Factor(['A'], [2], np.array([0.5, 0.5]))

    # Zip Code: binary [0=Urban, 1=Rural] - Proxy attribute
    # P(Z | A)
    values_Z = np.zeros((2, 2))  # A, Z
    values_Z[0, :] = [0.8, 0.2]  # P(Z | A=Young)
    values_Z[1, :] = [0.3, 0.7]  # P(Z | A=Old)
    factor_Z = Factor(['A', 'Z'], [2, 2], values_Z)

    # Income: binary [0=Low, 1=High]
    # P(I | A)
    values_I = np.zeros((2, 2))  # A, I
    values_I[0, :] = [0.7, 0.3]  # P(I | A=Young)
    values_I[1, :] = [0.4, 0.6]  # P(I | A=Old)
    factor_I = Factor(['A', 'I'], [2, 2], values_I)

    # Loan Approved: binary [0=False, 1=True]
    # P(L | I, Z)
    values_L = np.zeros((2, 2, 2))  # I, Z, L
    # I=Low, Z=Urban
    values_L[0, 0, :] = [0.9, 0.1]   # P(L | I=Low, Z=Urban)
    # I=Low, Z=Rural
    values_L[0, 1, :] = [0.7, 0.3]   # P(L | I=Low, Z=Rural)
    # I=High, Z=Urban
    values_L[1, 0, :] = [0.2, 0.8]   # P(L | I=High, Z=Urban)
    # I=High, Z=Rural
    values_L[1, 1, :] = [0.1, 0.9]   # P(L | I=High, Z=Rural)
    factor_L = Factor(['I', 'Z', 'L'], [2, 2, 2], values_L)

    return [factor_A, factor_Z, factor_I, factor_L]

