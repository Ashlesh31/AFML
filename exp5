def reduce_factors(factors, var, value):
    out = []
    for f in factors:
        if var not in f.variables:
            out.append(f)
            continue
        idx = f.variables.index(var)
        new_vars = [v for v in f.variables if v != var]
        if not new_vars:                 # constant factor, normalization handles it
            continue
        new_cards = [c for i, c in enumerate(f.cardinalities) if i != idx]
        out.append(Factor(new_vars, new_cards, np.take(f.values, value, axis=idx)))
    return out

